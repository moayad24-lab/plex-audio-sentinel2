PLEX_MEDIA_PATH=/path/to/media
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your-plex-token
PLEX_SECTION=1
FFMPEG=ffmpeg
FFPROBE=ffprobe
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Baseline state file recording source media paths already seen.
# Default: <PLEX_MEDIA_PATH>/.plex-audio-sentinel-state.json
# Override when the media root is read-only or state must live elsewhere.
PLEX_STATE_FILE=
