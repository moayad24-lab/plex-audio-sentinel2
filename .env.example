PLEX_MEDIA_PATH=/path/to/media
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your-plex-token
PLEX_SECTION=1
FFMPEG=ffmpeg
FFPROBE=ffprobe
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Single folder where ALL generated companion files are written.
# Companions are never written beside the originals. The folder is excluded
# from source discovery, even when nested under PLEX_MEDIA_PATH. Example used
# by the current Windows test client:
PLEX_OUTPUT_PATH=E:\Plex Media Server\Converted
# Baseline state file recording source media paths already seen.
# Default: <PLEX_MEDIA_PATH>/.plex-audio-sentinel-state.json
# Override when the media root is read-only or state must live elsewhere.
PLEX_STATE_FILE=
